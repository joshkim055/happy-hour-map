# Copy this file to .env (same folder) and fill in your real keys.
# .env is ignored by Git, so your keys never end up on GitHub.

ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://wvlenyuzymctiinajgai.supabase.co
# The SECRET key (Supabase → Project Settings → API Keys → secret / service_role).
# It can write to the database, so never put it in the website or on GitHub.
SUPABASE_SERVICE_ROLE_KEY=...
GOOGLE_MAPS_API_KEY=...

# Optional settings
# ANTHROPIC_MODEL=claude-sonnet-5-5
# RECHECK_LIMIT=15
